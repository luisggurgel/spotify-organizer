SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/callback

DATABASE_PATH=spotify_organizer.db
LANGUAGE_CONFIDENCE_THRESHOLD=0.70
LANGUAGE_CONFIDENCE_MARGIN=0.20
ISRC_FALLBACK_THRESHOLD=0.50
ISRC_FALLBACK_MARGIN=0.12
MIN_LYRICS_CHARS=45
MIN_UNIQUE_WORDS=7

LRCLIB_USER_AGENT=SpotifyOrganizer/1.1.0 (https://github.com/luisggurgel/spotify-organizer)
LRCLIB_MAX_CONCURRENCY=3
LYRICS_OVH_MAX_CONCURRENCY=3
# Optional: free key from https://auth.vagalume.com.br/ (greatly boosts PT/BR & Latin coverage)
VAGALUME_API_KEY=